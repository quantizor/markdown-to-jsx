#!/usr/bin/env bash
# Local and CI quality gate. Wave 0 (Biome) mutates the tree; wave 1 fans out
# read-only checks; wave 2 builds dist; wave 3 fans out dist/golden checks.
# Browser and native harnesses stay separate CI steps after verify.
#
# Quiet by design: a successful run prints one final line. A failing phase or
# job prints its own captured output (and nothing else) to stderr, then aborts,
# so the signal is never buried under the output of the steps that passed.
set -euo pipefail
cd "$(dirname "$0")/.."

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
head=$(git rev-parse --short HEAD 2>/dev/null || echo "?")

# Run a foreground step with its output captured; surface it only on failure.
phase() {
  local name=$1
  shift
  local log status=0
  log=$(mktemp "${TMPDIR:-/tmp}/verify-${name}.XXXXXX")
  "$@" >"${log}" 2>&1 || status=$?
  if [[ "${status}" -ne 0 ]]; then
    echo "==> ${name}: FAILED" >&2
    cat "${log}" >&2
    rm -f "${log}"
    exit "${status}"
  fi
  rm -f "${log}"
}

# Run a named job in the background, capturing its status and output.
declare -a BG_NAMES=()
declare -a BG_PIDS=()
declare -a BG_LOGS=()

bg_job() {
  local name=$1
  shift
  local log
  log=$(mktemp -t "verify-${name}.XXXXXX")
  (
    set +e
    "$@" >"${log}.out" 2>&1
    status=$?
    set -e
    {
      echo "status=${status}"
      echo "---- output ----"
      cat "${log}.out"
    } >"${log}"
    rm -f "${log}.out"
    exit "${status}"
  ) &
  BG_NAMES+=("${name}")
  BG_PIDS+=("$!")
  BG_LOGS+=("${log}")
}

# Wait for the current wave. Quiet on success; on any failure print the failing
# jobs' captured output to stderr and abort.
wait_wave() {
  local wave=$1
  local fail=0
  local i name pid log status
  for i in "${!BG_PIDS[@]}"; do
    name="${BG_NAMES[$i]}"
    pid="${BG_PIDS[$i]}"
    log="${BG_LOGS[$i]}"
    set +e
    wait "${pid}"
    set -e
    if [[ -f "${log}" ]]; then
      status=$(sed -n 's/^status=//p' "${log}" | head -1)
      if [[ "${status}" != "0" ]]; then
        echo "==> ${name}: FAILED (wave ${wave})" >&2
        sed -n '/^---- output ----$/,$p' "${log}" | tail -n +2 >&2
      fi
      rm -f "${log}"
    else
      status=1
      echo "==> ${name}: FAILED (wave ${wave}, missing log)" >&2
    fi
    [[ "${status}" != "0" ]] && fail=1
  done
  BG_NAMES=()
  BG_PIDS=()
  BG_LOGS=()
  [[ "${fail}" -ne 0 ]] && exit 1
  return 0
}

# --- Wave 0: Biome (serial; only mutator of the source tree) ---
# Snapshot tracked-file state first so the audit blames only what Biome rewrote,
# not edits already in flight locally (CI checks out clean; local often does not).
pre_biome_diff=$(git diff HEAD)
phase "biome" bunx biome check --write --unsafe .

if [[ "$(git diff HEAD)" != "${pre_biome_diff}" ]]; then
  if [[ -n "${CI:-}" ]]; then
    git --no-pager diff --stat >&2
    echo "Biome rewrote tracked files; run 'bun run format' locally and commit the result." >&2
    exit 1
  fi
  # Local: Biome fixed formatting in flight. Surface it so the user commits it.
  echo "==> biome rewrote files (review and commit):" >&2
  git --no-pager diff --stat >&2
fi

# --- Wave 1: parallel source checks (no dist required) ---
# Metrics and scaling run after the other wave-1 jobs so CPU contention does not
# inflate their timings: both compare a measurement against a threshold, and
# sibling jobs competing for cores are enough to move either verdict.
bg_job "knip" bunx knip
bg_job "typecheck" bun run typecheck
bg_job "validate-i18n" bun run validate-i18n
bg_job "test+coverage" bash -c '
  set -euo pipefail
  cov=$(mktemp -t verify-cov.XXXXXX)
  # Keep suite under 5s; coverage floor is checked after.
  timeout 5 bun test --coverage >"${cov}" 2>&1 || {
    status=$?
    cat "${cov}"
    rm -f "${cov}"
    exit "${status}"
  }
  cat "${cov}"
  bun scripts/check-coverage.ts "${cov}"
  rm -f "${cov}"
'
bg_job "redos-smoke" bun scripts/redos-smoke.ts
bg_job "parser-changesets" bun scripts/check-inlined-parser-changesets.ts
wait_wave 1a

bg_job "metrics-gate" bash -c '
  set -euo pipefail
  fail=0
  for target in parser react react-native html solid vue markdown; do
    bun scripts/metrics-gate.ts --target "${target}" || fail=1
  done
  bun scripts/scaling-smoke.ts || fail=1
  exit "${fail}"
'
wait_wave 1b

# --- Wave 2: build (serial; supplies lib/dist for wave 3) ---
phase "build" bun run build

# --- Wave 3: parallel dist / golden checks ---
# Harness typecheck belongs here: browser/native resolve marqdown/* through
# package exports into lib/dist, which wave 2 just produced.
bg_job "typecheck:harness" bun run typecheck:harness
bg_job "emit-selfcheck-dev" bun scripts/emit-selfcheck.ts
bg_job "emit-selfcheck-prod" env NODE_ENV=production bun scripts/emit-selfcheck.ts
bg_job "prod-strip-check" bun scripts/prod-strip-check.ts
bg_job "hermetic-dist" bun scripts/hermetic-dist.ts
bg_job "llms-snippets" bun scripts/llms-snippets.ts
bg_job "attw" bun scripts/attw-packages.ts
wait_wave 3

echo "verify ok (${branch} @ ${head})"
